---
import BaseLayout from '../layouts/BaseLayout.astro';
import Directory from '../components/Directory.astro';
import HoodCanvas from '../components/HoodCanvas.astro';
---

<BaseLayout>
  <main id="main-content">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow">Privacy starts with the right tool</p>
        <h1 id="hero-title"><span class="hero__title-line">The privacy tool</span><br /><span class="hero__title-line">directory<span class="hero__period">.</span></span></h1>
        <p class="hero__lede">Find tools for private browsing, messaging, email and more.</p>
        <form class="search" role="search" aria-label="Search the directory">
          <label class="search__label" for="tool-search">Search the directory</label>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m15.5 15.5 5 5"></path>
          </svg>
          <input id="tool-search" type="search" placeholder="Search tools or use cases…" autocomplete="off" spellcheck="false" />
          <kbd aria-label="Keyboard shortcut: slash">/</kbd>
        </form>
        <p class="hero__privacy"><span aria-hidden="true"></span> Search runs locally. Nothing is sent or stored.</p>
      </div>
      <div class="hero__art">
        <HoodCanvas />
      </div>
    </section>
    <Directory />
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(46rem, calc(100vh - 7rem));
    padding-top: clamp(3.5rem, 7vw, 6.5rem);
    padding-bottom: 2.5rem;
    align-items: center;
    grid-template-columns: minmax(0, 1.02fr) minmax(25rem, 0.98fr);
    gap: clamp(1rem, 3vw, 3rem);
  }

  .hero::after {
    position: absolute;
    right: var(--page-gutter);
    bottom: 0;
    left: var(--page-gutter);
    height: 1px;
    background: var(--line);
    content: '';
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    min-width: 0;
    padding-bottom: 2rem;
  }

  .hero h1 {
    max-width: none;
    margin: 0;
    font-size: clamp(4.2rem, 6vw, 6.2rem);
    font-weight: 520;
    letter-spacing: -0.078em;
    line-height: 0.86;
  }

  .hero__title-line {
    white-space: nowrap;
  }

  .hero h1 .hero__period {
    color: var(--accent);
  }

  .hero__lede {
    max-width: 35rem;
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.5;
  }

  .search {
    position: relative;
    display: flex;
    width: min(100%, 36rem);
    height: 4rem;
    margin-top: 2.5rem;
    align-items: center;
    border: 1px solid var(--line-strong);
    background: #020507;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 13%, transparent);
  }

  .search__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .search svg {
    width: 1.25rem;
    margin-left: 1.25rem;
    flex: none;
    fill: none;
    stroke: var(--accent);
    stroke-linecap: square;
    stroke-width: 1.5;
  }

  .search input {
    width: 100%;
    height: 100%;
    min-width: 0;
    padding: 0 0.8rem 0 1rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-size: 1rem;
  }

  .search input::placeholder {
    color: #737e87;
    opacity: 1;
  }

  .search input::-webkit-search-cancel-button {
    filter: invert(1);
  }

  .search kbd {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: 1rem;
    place-items: center;
    flex: none;
    border: 1px solid var(--line-strong);
    background: var(--surface-raised);
    color: var(--muted);
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
  }

  .hero__privacy {
    display: flex;
    margin: 0.8rem 0 0;
    align-items: center;
    gap: 0.5rem;
    color: var(--faint);
    font-size: 0.75rem;
  }

  .hero__privacy span {
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid var(--accent);
    transform: rotate(45deg);
  }

  .hero__art {
    min-width: 0;
    align-self: center;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero__copy {
      padding-bottom: 0;
    }

    .hero h1 {
      font-size: clamp(3.8rem, 11vw, 5.6rem);
    }

    .hero__art {
      width: min(100%, 38rem);
      margin: -1rem auto 0;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 3.25rem;
      padding-bottom: 1.25rem;
      gap: 0.5rem;
    }

    .hero h1 {
      font-size: clamp(2.85rem, 11.8vw, 3.4rem);
      line-height: 0.9;
    }

    .hero__lede {
      margin-top: 1.4rem;
      font-size: 1rem;
    }

    .search {
      height: 3.65rem;
      margin-top: 1.7rem;
    }

    .search kbd {
      display: none;
    }

    .hero__privacy {
      font-size: 0.69rem;
    }

    .hero__art {
      width: min(100%, 24rem);
      margin-top: -0.25rem;
    }
  }
</style>
